@{
    Layout = null;
    string thankYouContent = ViewBag.ThankYouContent as string;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Thank You</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background:#f0f2f5;">
    <div class="container d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="bg-white p-5 rounded shadow-sm text-center" style="max-width:500px;">
            @if (ViewBag.LogoUrl != null)
            {
                <img src="@ViewBag.LogoUrl" style="max-height:90px;" class="mb-3" />
            }
            @if (!string.IsNullOrWhiteSpace(thankYouContent))
            {
                <div class="thank-you-custom-content text-start">
                    @Html.Raw(thankYouContent)
                </div>
            }
            else
            {
                <div class="mb-3">
                    <span style="font-size:60px; color:#28a745;">✔</span>
                </div>
                <h2 class="fw-bold">Thank You!</h2>
                <p class="text-muted">Your submission has been received.</p>
            }
            <a href="@Url.Action("Index", "Form")" class="btn btn-primary mt-3">Back to Form List</a>
        </div>
    </div>
</body>
</html>
