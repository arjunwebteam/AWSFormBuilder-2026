@{
    Int64 formId = (Int64)ViewBag.FormId;
    string formTitle = (string)ViewBag.FormTitle;
    string thankYouContent = (string)ViewBag.ThankYouContent;

    ViewBag.Title = "Thank You Page";
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
    ViewBag.Pageheading = "Thank You Page - " + formTitle;
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#wForm,#wFormsList').addClass('active');

    });
</script>
<script type="text/javascript" src="ckeditor/ckeditor.js"></script>
<style>

    .btn-save-form {
        background: #4a7cf6;
        border: none;
        border-radius: 8px;
        padding: 9px 22px;
        font-weight: 600;
        color: #fff;
    }

        .btn-save-form:hover {
            background: #3763d8;
            color: #fff;
        }
</style>
<div class="content">
    @if (TempData["message"] != null)
    {
        <div class="mb-3">
            @Html.Raw(TempData["message"])
        </div>
    }

    @using (Html.BeginForm("EditThankYouPage", "Form", FormMethod.Post, new { @id = "ThankYouPageForm", @name = "ThankYouPageForm" }))
    {
        <input id="FormId" name="FormId" value="@formId" type="hidden" />

        <div class="box validation">

            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">Thank You Page — @formTitle</h4>
                        <p class="text-muted mb-0">
                            This content is shown to the user after they submit "@formTitle".
                        </p>
                    </div>
<button type="button" class="btn-save-form"
        onclick="window.location.href='@Url.Action("Index", "Form")'">
    ← Back to Form List
</button>
                </div>
            </div>
          
            <div class="card">
                <div class="card-body">
                    <div class="box validation">
                        <div class="box-header">
                            <h3 class="box-title dis-in">Content <span class="text-danger">*</span></h3>
                        </div>
                        <div class="box-body">
                            <div class="row g-3">
                                <div class="col-lg-12">
                                    <div class="input-box">
                                        <textarea rows="10" placeholder="Thank You Page Content *" name="ThankYouContent" id="ThankYouContent" cols="80" style="visibility: hidden; display: none;">@Html.Raw(thankYouContent)</textarea><br />
                                        <span class="field-validation-error" id="ThankYouContentError"></span>
                                    
                                        <script type="text/javascript">

                                                                                var editor = CKEDITOR.replace('ThankYouContent', {
                                                contentsCss: '../css/editor.css',
                                                filebrowserBrowseUrl: '/filemanager/browse.html',
                                                filebrowserImageBrowseUrl: '/filemanager/browse.html',
                                                filebrowserUploadUrl: '/api/filemanager/upload',
                                                filebrowserImageUploadUrl: '/api/filemanager/upload'
                                            });





                                        </script>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 col-3 text-end ms-auto">
                <button type="submit" class="btn btn-success px-3" value="submit">Submit</button>
                <a class="btn btn-primary px-3" href="@Url.Action("Index", "Form")">Cancel</a>
            </div>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        $("#ThankYouPageForm").submit(function () {
            for (var instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }
        });

        $("#ThankYouPageForm").validate({
            rules: {
                ThankYouContent: "required"
            },
            messages: {
                ThankYouContent: "Thank You Page content is required"
            },
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");
                error.insertAfter(element);
                if (element.closest(".input-box").length) {
                    element.closest(".input-box").after(error);
                }
            },
            highlight: function (element, errorClass, validClass) {
                var $element = $(element);
                if ($element.is('input, textarea, select')) {
                    $element.addClass("is-invalid").removeClass("is-valid");
                }
            },
            unhighlight: function (element, errorClass, validClass) {
                var $element = $(element);
                if ($element.is('input, textarea, select')) {
                    $element.addClass("is-valid").removeClass("is-invalid");
                }
            }
        });
    });
</script>
