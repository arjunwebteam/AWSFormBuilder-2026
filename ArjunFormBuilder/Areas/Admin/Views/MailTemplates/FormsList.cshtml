@{
    Layout = null;
}
@{
    string sortcolumn = (string)ViewBag.sortcolumn;
    string sortorder = (string)ViewBag.sortorder;
    Int64 Total = (Int64)ViewBag.total;
    var PageNo = (Int64)ViewBag.pageno;
    var Items = (Int64)ViewBag.items;

    List<ArjunFormBuilder.Entities.FormModel> lstForms = ViewBag.lstForms;
}

<div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th width="5%" style="text-align:center">S.No.</th>
                <th width="20%">
                    <a class="cursor-pointer" style="color:black;" onclick="sortresult('Title');">
                        Form Title @if (sortcolumn == "Title") {
                        <img alt="@sortorder" src="Content/Admin/images/sort_@(sortorder).gif" />
                                                }
                    </a>
                </th>
                <th width="15%">
                    <a class="cursor-pointer" style="color:black;" onclick="sortresult('Title');">
                        Registrations @if (sortcolumn == "Registrations") {
                        <img alt="@sortorder" src="Content/Admin/images/sort_@(sortorder).gif" />
                                                }
                    </a>
                </th>
                <th width="15%">
                    <a class="cursor-pointer" style="color:black;" onclick="sortresult('Title');">
                        Thank You Page @if (sortcolumn == "Registrations") {
                        <img alt="@sortorder" src="Content/Admin/images/sort_@(sortorder).gif" />
                                                }
                    </a>
                </th>
                <th width="15%">Mail Templates</th>
                <th style="text-align:center" width="10%">
                    <a class="cursor-pointer" style="color:black;" onclick="sortresult('IsActive');">
                        IsActive @if (sortcolumn == "IsActive") {
                        <img alt="@sortorder" src="Content/Admin/images/sort_@(sortorder).gif" />
                                                }
                    </a>
                </th>
                <th style="text-align:center" width="15%">
                    <a class="cursor-pointer" style="color:black;" onclick="sortresult('CreatedDate');">
                        Created Date @if (sortcolumn == "CreatedDate") {
                        <img alt="@sortorder" src="Content/Admin/images/sort_@(sortorder).gif" />
                                                }
                    </a>
                </th>
                <th width="15%">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (lstForms.Count != 0)
            {
                foreach (var item in lstForms)
                {
                    <tr>
                        <td style="text-align:center">@item.RId</td>
                      <td style="text-align:left">
    <a href="@Url.Action("RenderForm", "Form", new { id = item.FormId })" target="_blank" class="text-decoration-none" style="color:#007BFF; font-weight:500;">
        @item.Title
    </a>
</td>
<td style="text-align:left">
<a class="text-success cursor-pointer" href="@Url.Action("FormSubmissions", "Form", new { formId = item.FormId })" title="Registrations">
    Registrations
</a>
</td>

<td style="text-align:left">
<a class="text-success cursor-pointer" href="@Url.Action("EditThankYouPage", "Form", new { id = item.FormId })" title="Thank You Page">
      Thank You Page
</a>
</td>
<td style="text-align:left">
    <a class="text-primary cursor-pointer d-block" href="@Url.Action("EditByForm", "MailTemplates", new { formId = item.FormId, mailType = "Admin" })" title="Admin Mail">
        Admin Mail
    </a>
    <a class="text-success cursor-pointer d-block" href="@Url.Action("EditByForm", "MailTemplates", new { formId = item.FormId, mailType = "Auto" })" title="User Mail">
        User Mail
    </a>
</td>
                        <td style="text-align:center">
                            @{
                                var isChecked = item.IsActive ? "checked" : "";
                            }
                            @{
                                var titleValue = item.IsActive ? "Active" : "Disabled";
                            }
                            <label class="switch" title="@titleValue">
                                <input type="checkbox" onclick="FormStatus(@item.FormId)" @isChecked>
                                <span class="slider"></span>
                            </label>
                        </td>
                        <td style="text-align:center">@item.CreatedDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                        <td style="text-align:center">
                            <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                <a class="text-warning cursor-pointer" href="@Url.Action("FormBuilder", "Form", new { id = item.FormId })" title="Edit"><i class="bi bi-pencil-fill"></i></a>
                                <a class="text-primary cursor-pointer" href="@Url.Action("RenderForm", "Form", new { id = item.FormId })" target="_blank" title="View"><i class="bi bi-eye-fill"></i></a>
                                <a class="text-danger cursor-pointer" onclick="DeleteForm(@item.FormId);" title="Delete"><i class="bi bi-trash-fill"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="text-center">No Records found</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="row pt-3">
    <div class="col-sm-4 col-md-5">
        <div class="dataTables_info">
            Showing @((PageNo * Items) - (Items - 1)) - @((PageNo * Items) > Total ? Total : (PageNo * Items)) of @Total entries
        </div>
    </div>
    <div class="col-sm-3 col-md-7">
        <div class="d-flex justify-content-end">
            @Html.Raw(ArjunFormBuilder.BLL.Common.SetPaging((Int64)ViewBag.items, ref Total, (Int64)ViewBag.pageno, "pagination pb-0"))
        </div>
    </div>
</div>
